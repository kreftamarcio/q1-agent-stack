# ============================================================
# Q1 Agent Stack - Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ClickUp (required for task management)
CLICKUP_API_KEY=pk_YOUR_CLICKUP_PERSONAL_TOKEN
CLICKUP_WORKSPACE_ID=YOUR_WORKSPACE_ID
CLICKUP_PRIMARY_LANGUAGE=pt-BR

# GitHub (required for code management)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_YOUR_GITHUB_TOKEN
GH_TOKEN=ghp_YOUR_GITHUB_TOKEN

# Vercel (required for deployments)
VERCEL_TOKEN=YOUR_VERCEL_TOKEN
VERCEL_ORG_ID=YOUR_ORG_ID
VERCEL_PROJECT_ID=YOUR_PROJECT_ID

# AI Models (optional, for cost-aware routing)
GEMINI_API_KEY=YOUR_GEMINI_KEY
GROQ_API_KEY=YOUR_GROQ_KEY
OPENAI_API_KEY=YOUR_OPENAI_KEY

# Context Mode (optional)
MAX_RESPONSE_SIZE_MB=5
